ROOT = Path(__file__).resolve().parent


def slug(text: str) -> str:
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode().lower()
    return re.sub(r"(^-|-$)", "", re.sub(r"[^a-z0-9]+", "-", text))


def show(path: Path) -> str:
    """Repository-relative path when possible; an error message must not throw."""
    try:
        return str(path.resolve().relative_to(ROOT))
    except ValueError:
        return str(path)


def load(path: Path) -> dict:
    """Read a JSON file, naming it if it cannot be read or will not parse."""
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as error:
        raise SystemExit(f"{show(path)}: file missing") from error
    except OSError as error:
        raise SystemExit(f"{show(path)}: cannot read ({error.strerror or error})") from error
    except json.JSONDecodeError as error:
        raise SystemExit(f"{show(path)}: invalid JSON ({error})") from error


@lru_cache(maxsize=None)
def load_config(name: str) -> dict:
    """Load a config/ file once per (short-lived) CLI invocation."""
    return load(ROOT / "config" / name)


def read_json(path: Path) -> dict | None:
    """Parse a file that may be absent or mid-edit, without exiting.

    Reporting on the library must survive one broken book: a file another
    agent is halfway through writing should cost that book its row, not the
    whole command.
    """
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def save(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def replace_tree(path: Path, replacements: dict[str, str]) -> None:
    for file in path.rglob("*"):
        if not file.is_file():
            continue
        text = file.read_text(encoding="utf-8")
        for old, new in replacements.items():
            text = text.replace(old, new)
        file.write_text(text, encoding="utf-8")


def normalise(text: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"[^a-z0-9 ]+", "", text.casefold())).strip()


def find_duplicate(catalog: dict, title: str) -> dict | None:
    wanted_full = normalise(title)
    wanted_short = normalise(title.split(":", 1)[0])
    for entity in catalog["entities"]:
        if entity["kind"] != "book":
            continue
        for name in (entity["name"], *entity.get("aliases", [])):
            known = normalise(name)
            if known == wanted_full or normalise(name.split(":", 1)[0]) == wanted_short:
                return entity
    return None


def scaffold_scripts(book_dir: Path, book_id: str) -> None:
    """Write one script stub per configured level.

    config/audio.json owns the levels and their word targets, so the templates
    supply only the per-level writing guidance. Deriving the front matter here
    keeps a retargeted or newly added level from scaffolding books that fail
    ./bookflow check.
    """
    levels = load_config("audio.json")["levels"]
    scripts_dir = book_dir / "scripts"
    templates = ROOT / "templates/book/scripts"
    scripts_dir.mkdir(parents=True, exist_ok=True)
    for path in scripts_dir.glob("*.md"):
        path.unlink()
    for level, settings in levels.items():
        template = templates / f"{level}.md"
        guidance = (parse_front_matter(template)[1].strip() if template.exists()
                    else settings.get("purpose", "Write an audio-ready treatment."))
        (scripts_dir / f"{level}.md").write_text(
            "---\n"
            f"book_id: {book_id}\n"
            f"duration: {level}\n"
            f"target_words: {settings['target_words']}\n"
            "source: content.json\n"
            "status: stub\n"
            "---\n\n"
            f"{guidance}\n",
            encoding="utf-8",
        )


def scaffold_replacements(names: dict[str, str]) -> dict[str, str]:
    """Placeholder substitutions, plus the two every scaffold shares.

    Kept in one place because both scaffolds need them and only one of the two
    used to: a template sits two levels below the repository root and its copy
    sits three, so the schema pointer moves with it. Keeping the template
    pointer correct where it lives is what lets an editor validate the
    template — nothing else does.
    """
    today = date.today().isoformat()
    return {**names, "YYYY-MM-DD": today, "1970-01-01": today,
            '"../../schemas/': '"../../../schemas/'}


def init_book(args: argparse.Namespace) -> None:
    if not slug(args.title):
        raise SystemExit("--title must contain at least one letter or number")
    if not slug(args.author):
        raise SystemExit("--author must contain at least one letter or number")
    for flag, value in (("--book-id", args.book_id), ("--author-id", args.author_id)):
        if value and slug(value) != value:
            raise SystemExit(f"{flag} must be lowercase kebab-case; try '{slug(value)}'")
    author_id = args.author_id or slug(args.author)
    short_title = args.title.split(":", 1)[0]
    book_id = args.book_id or f"{slug(short_title)}-{slug(args.author.split()[-1])}"
    # A title or surname with no ASCII-able characters derives a malformed id
    # (a CJK title gives '-surname'); ask for one rather than scaffold it.
    # Only the book id can be malformed here: author_id is slug() output,
    # and slug is idempotent.
    if slug(book_id) != book_id:
        raise SystemExit(
            f"Could not derive a usable book id from the title and author "
            f"(got '{book_id}'). Pass --book-id explicitly.")
    book_dir = ROOT / "library/books" / book_id
    author_dir = ROOT / "library/authors" / author_id
    catalog_path = ROOT / "data/catalog.json"
    catalog = load(catalog_path)
    by_id = {item["id"]: item for item in catalog["entities"]}
    if book_dir.exists():
        raise SystemExit(f"Book already exists: {book_dir.relative_to(ROOT)}")
    if book_id in by_id and by_id[book_id]["kind"] != "book":
        raise SystemExit(f"ID already belongs to a non-book entity: {book_id}")
    if author_id in by_id and by_id[author_id]["kind"] != "author":
        raise SystemExit(f"ID already belongs to a non-author entity: {author_id}")
    duplicate = find_duplicate(catalog, args.title)
    if duplicate and duplicate["id"] != book_id and not args.force:
        raise SystemExit(
            f"A catalogued entry looks like the same work: '{duplicate['name']}' "
            f"(id: {duplicate['id']}, state: {duplicate['state']}).\n"
            "If this really is a different work, re-run with --force and a --book-id "
            "that includes the first publication year."
        )

    shutil.copytree(ROOT / "templates/book", book_dir)
    replace_tree(book_dir, scaffold_replacements({
        "book-id": book_id,
        "author-id": author_id,
        "Book title": args.title,
    }))
    # After replace_tree: these carry the real id already, and substituting
    # into them again would expand an id that contains 'book-id' twice.
    scaffold_scripts(book_dir, book_id)
    (book_dir / "audio").mkdir()
    (book_dir / "audio/.gitkeep").touch()

    author_is_new = not author_dir.exists()
    if author_is_new:
        shutil.copytree(ROOT / "templates/author", author_dir)
        replace_tree(author_dir, scaffold_replacements({
            "author-id": author_id,
            "Author name": args.author,
        }))

    upsert_entity(catalog, by_id, {
        "id": author_id,
        "kind": "author",
        "name": args.author,
        "state": "catalogued",
        "path": f"library/authors/{author_id}/author.json",
    })
    upsert_entity(catalog, by_id, {
        "id": book_id,
        "kind": "book",
        "name": args.title,
        "state": "catalogued",
        "path": f"library/books/{book_id}/book.json",
        "author_ids": [author_id],
    })
    catalog["entities"].sort(key=lambda item: (item["kind"], item["name"].casefold()))
    save(catalog_path, catalog)

    queue_add(book_id, source="discovery" if args.discovered else "user",
              notes=args.note or "")

    print(f"Created {book_dir.relative_to(ROOT)} and queued it for processing")
    # Author ids are derived from the name, so two different people can share
    # one. Say which profile this book joined, so a collision is visible now
    # rather than after research has been written into the wrong one.
    print(f"Author profile: {author_dir.relative_to(ROOT)} "
          + ("(new)" if author_is_new else "(existing — check it is the same person)"))
    print("\nResearch prompt for an agent:\n")
    print(research_prompt(args.title, args.author, book_id))


def upsert_entity(catalog: dict, by_id: dict, entry: dict) -> None:
    """Add a catalogue entry, or refresh one in place, keeping its aliases.

    In place so a promoted stub holds its position until the list is sorted
    again, and aliases survive because they are researched, not scaffolded.
    """
    existing = by_id.get(entry["id"])
    entry = {**entry, "aliases": (existing or {}).get("aliases", [])}
    if existing is None:
        catalog["entities"].append(entry)
    else:
        existing.clear()
        existing.update(entry)


def research_prompt(title: str, author: str, book_id: str) -> str:
    return (
        f"  Complete the profile for '{title}' by {author} "
        f"(book id: {book_id}) in this repository.\n"
        "  Follow AGENTS.md exactly: research authoritative online sources first,\n"
        f"  fill library/books/{book_id}/book.json and content.json with cited\n"
        "  claims, complete the author profile if it is new, add canonical tags,\n"
        "  catalog aliases, and relationship edges with evidence. Score only the\n"
        "  content and ideas against config/rating.json, then calculate the total\n"
        f"  with ./bookflow rate {book_id} --write. Write and compare the narration\n"
        "  scripts, set the recommended level, run the adversarial review in\n"
        "  docs/review-method.md, then check pronunciation and generate audio.\n"
        "  Run ./bookflow check, fix every issue, and mark the queue\n"
        f"  entry done with: ./bookflow queue --set {book_id} done"
    )


QUEUE_STATUSES = ("ready", "in-progress", "done", "blocked")


def load_queue() -> dict:
    path = ROOT / "data/queue.json"
    if path.exists():
        return load(path)
    return {"$schema": "../schemas/queue.schema.json", "schema_version": 1, "queue": []}


def queue_add(book_id: str, source: str, notes: str = "") -> None:
    data = load_queue()
    if any(item["book_id"] == book_id for item in data["queue"]):
        return
    entry = {
        "book_id": book_id,
        "priority": max((item["priority"] for item in data["queue"]), default=0) + 1,
        "status": "ready",
        "source": source,
        "added_at": date.today().isoformat(),
    }
    if notes:
        entry["notes"] = notes
    data["queue"].append(entry)
    save(ROOT / "data/queue.json", data)


def book_needs(book_id: str) -> str:
    """Summarise what a queued book still needs, from its files."""
    directory = ROOT / "library/books" / book_id
    if not directory.exists():
        return "scaffold missing"
    needs = []
    content_path = directory / "content.json"
    content = read_json(content_path)
    if content is None and content_path.exists():
        # One unparseable book must not hide the rest of the queue.
        return "content (invalid JSON)"
    if content is None or "TODO" in json.dumps(content, ensure_ascii=False):
        needs.append("content")
    rating = (content or {}).get("assessment", {}).get("rating")
    if rating_errors(rating, load_config("rating.json")):
        needs.append("rating")
    quality_review = (content or {}).get("workflow", {}).get("quality_review", {})
    if quality_review.get("status") != "passed" or not all(
        quality_review.get("checks", {}).values()
    ):
        needs.append("adversarial review")
    book_path = directory / "book.json"
    if book_path.exists():
        book = read_json(book_path)
        if book is None:
            needs.append("book.json (invalid JSON)")
        elif not book.get("research", {}).get("sources"):
            needs.append("research")
    config = load_config("audio.json")
    missing_scripts, missing_audio = [], []
    for level in config["levels"]:
        script_path = directory / "scripts" / f"{level}.md"
        if not script_path.exists():
            continue
        script = parse_script(script_path)
        if script["meta"].get("status") != "complete":
            missing_scripts.append(level)
        elif not any(p for p in (directory / "audio").glob(f"{level}.*")
                     if p.suffix not in {".json", ".gitkeep"}):
            missing_audio.append(level)
    if missing_scripts:
        needs.append("scripts: " + ", ".join(missing_scripts))
    if missing_audio:
        needs.append("audio: " + ", ".join(missing_audio))
    return "; ".join(needs) or "nothing — ready to mark done"


def cmd_queue(args: argparse.Namespace) -> None:
    data = load_queue()
    if args.set:
        book_id, status = args.set
        if status not in QUEUE_STATUSES:
            raise SystemExit(f"status must be one of: {', '.join(QUEUE_STATUSES)}")
        for item in data["queue"]:
            if item["book_id"] == book_id:
                item["status"] = status
                save(ROOT / "data/queue.json", data)
                print(f"{book_id}: {status}")
                return
        raise SystemExit(f"not in queue: {book_id}")
    if not data["queue"]:
        print("Queue is empty. Add books with ./bookflow init, or run discovery (see AGENTS.md).")
        return
    print(f"{'#':>3}  {'status':12} {'source':10} {'book':44} needs")
    for item in sorted(data["queue"], key=lambda entry: entry["priority"]):
        needs = book_needs(item["book_id"]) if item["status"] != "done" else "—"
        print(f"{item['priority']:>3}  {item['status']:12} {item['source']:10} "
              f"{item['book_id']:44} {needs}")
        if item.get("notes"):
            print(f"{'':32}note: {item['notes']}")


def cmd_next(args: argparse.Namespace) -> None:
    data = load_queue()
    ready = sorted((item for item in data["queue"] if item["status"] == "ready"),
                   key=lambda entry: entry["priority"])
    if not ready:
        print("No books are marked ready.")
        print("Discovery step (AGENTS.md): research which related, popular, or important")
        print("books the existing library points to, add the strongest candidates with")
        print("./bookflow init, and record the relationship edges that justify them.")
        return
    item = ready[0]
    catalog = load(ROOT / "data/catalog.json")
    entity = next((e for e in catalog["entities"] if e["id"] == item["book_id"]), {})
    authors = ", ".join(
        next((e["name"] for e in catalog["entities"] if e["id"] == author_id), author_id)
        for author_id in entity.get("author_ids", [])
    ) or "unknown author"
    print(f"Next: {entity.get('name', item['book_id'])} — {authors}")
    print(f"Queue position {item['priority']} · source {item['source']}"
          + (f" · note: {item['notes']}" if item.get("notes") else ""))
    print(f"Still needs: {book_needs(item['book_id'])}\n")
    print(research_prompt(entity.get("name", item["book_id"]), authors, item["book_id"]))
    if args.claim:
        item["status"] = "in-progress"
        save(ROOT / "data/queue.json", data)
        print(f"\nMarked in-progress: {item['book_id']}")


def parse_script(path: Path) -> dict:
    meta, body = parse_front_matter(path)
    return {"meta": meta, "body": body, "words": word_count(body)}


def cmd_rate(args: argparse.Namespace) -> None:
    """Calculate a book's overall rating from its agent-assessed dimensions."""
    content_path = ROOT / "library/books" / args.book_id / "content.json"
    if not content_path.exists():
        raise SystemExit(f"content file missing: {content_path.relative_to(ROOT)}")
    rubric = load_config("rating.json")
    problems = rubric_errors(rubric)
    if problems:
        raise SystemExit("Invalid config/rating.json:\n  " + "\n  ".join(problems))
    content = load(content_path)
    rating = content.get("assessment", {}).get("rating")
    if rating is None:
        print("Add assessment.rating using these configured dimensions:")
        for item in rubric["dimensions"]:
            print(f"  {item['id']:30} {item['weight']:.0%}  {item['question']}")
        raise SystemExit("No rating found; complete the dimensions before calculating the total.")

    # A stale stored total is what --write exists to fix, so it must not stop
    # the read-only form from showing the calculated one. ./bookflow check
    # still treats a stale total as an error.
    problems = rating_errors(rating, rubric, check_total=False)
    if problems:
        raise SystemExit("Cannot calculate rating:\n  " + "\n  ".join(problems))

    total = calculate_rating(rating, rubric)
    if args.write:
        rating["score"] = total
        save(content_path, content)
        print(f"Updated {content_path.relative_to(ROOT)}")
    elif rating.get("score") != total:
        print(f"Stored score {rating.get('score')} is out of date; "
              f"re-run with --write to record {total:.1f}.")
    print(f"{args.book_id}: {total:.1f}/10 · {score_band(total, rubric)} "
          f"· {rating.get('confidence', 'confidence missing')} confidence")
    by_id = {item["id"]: item for item in rubric["dimensions"]}
    for item in rating["dimensions"]:
        configured = by_id[item["id"]]
        print(f"  {configured['label']:30} {item['score']:>4.1f} × {configured['weight']:.0%}")


APP_ASSETS = ("index.html", "app.js", "styles.css")


def clear_except_audio(dist: Path) -> None:
    """Empty dist/ ready for a rebuild, leaving the audio for sync_audio.

    Audio is almost all of the site and changes only when a book is re-voiced,
    so deleting and recopying it would rewrite hundreds of megabytes to answer
    an edit to one sentence — on every build, and on every serve, which builds
    first.
    """
    for path in sorted(dist.iterdir()) if dist.exists() else ():
        if path == dist / "audio":
            continue
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink()
    (dist / "data").mkdir(parents=True, exist_ok=True)


def sync_audio(source: Path, destination: Path) -> bool:
    """Copy unless the destination already matches. True when it copied."""
    if destination.exists():
        there, here = destination.stat(), source.stat()
        # copy2 carries the source mtime across, so equal size and mtime means
        # this is the same recording; re-voicing a level always moves it.
        if (there.st_size, int(there.st_mtime)) == (here.st_size, int(here.st_mtime)):
            return False
    shutil.copy2(source, destination)
    return True


def prune_audio(dist: Path, keep: set[Path]) -> int:
    """Delete built audio the library no longer produces. Returns how many."""
    audio_root = dist / "audio"
    if not audio_root.exists():
        return 0
    removed = 0
    for path in sorted(audio_root.rglob("*")):
        if path.is_file() and path not in keep:
            path.unlink()
            removed += 1
    for book_dir in sorted(audio_root.iterdir()):
        if book_dir.is_dir() and not any(book_dir.iterdir()):
            book_dir.rmdir()
    return removed


def build_app(_: argparse.Namespace | None = None) -> None:
    """Assemble dist/: a root-layout static site deployable to any static host."""
    config = load_config("audio.json")
    rating_config = load_config("rating.json")
    catalog = load(ROOT / "data/catalog.json")
    relations = load(ROOT / "data/relationships.json")["relationships"]
    tags = {tag["id"]: tag for tag in load(ROOT / "taxonomy/tags.json")["tags"]}
    authors: dict[str, dict] = {}
    for path in sorted((ROOT / "library/authors").glob("*/author.json")):
        author = load(path)
        authors[author["id"]] = author

    dist = ROOT / "dist"
    clear_except_audio(dist)
    for asset in APP_ASSETS:
        shutil.copy2(ROOT / "app" / asset, dist / asset)

    books = []
    built_audio: set[Path] = set()
    written = 0
    for book_path in sorted((ROOT / "library/books").glob("*/book.json")):
        directory = book_path.parent
        content_path = directory / "content.json"
        if not content_path.exists():
            continue
        book = load(book_path)
        content = load(content_path)
        scripts = {}
        for level in config["levels"]:
            script_path = directory / "scripts" / f"{level}.md"
            if not script_path.exists():
                continue
            script = parse_script(script_path)
            # audio variants per voice: <level>.<voice>.<format> + sidecar json
            variants = {}
            for audio in sorted((directory / "audio").glob(f"{level}.*")):
                if audio.suffix in {".json", ".gitkeep"}:
                    continue
                parts = audio.name.split(".")
                voice = parts[1] if len(parts) == 3 else "unknown"
                sidecar_path = directory / "audio" / f"{level}.{voice}.json"
                seconds = load(sidecar_path).get("audio_seconds") if sidecar_path.exists() else None
                destination = dist / "audio" / book["id"] / audio.name
                destination.parent.mkdir(parents=True, exist_ok=True)
                written += sync_audio(audio, destination)
                built_audio.add(destination)
                variants[voice] = {
                    "url": f"audio/{book['id']}/{audio.name}",
                    "seconds": seconds,
                }
            scripts[level] = {
                **script,
                "target_words": config["levels"][level]["target_words"],
                "audio": variants,
            }
        try:
            books.append({
                "id": book["id"],
                "title": book["title"],
                "authors": [authors[aid] for aid in book["author_ids"] if aid in authors],
                "bibliography": book["bibliography"],
                "discovery": book["discovery"],
                "tag_details": [tags[tid] for tid in book["discovery"]["tag_ids"] if tid in tags],
                "research": book["research"],
                "workflow": book["workflow"],
                "content": content,
                "scripts": scripts,
                "relationships": [rel for rel in relations
                                  if book["id"] in (rel["source_id"], rel["target_id"])],
            })
        except KeyError as missing:
            # check reports every such gap at once; build should point there
            # rather than end in a traceback naming one key.
            raise SystemExit(f"{show(book_path)}: required field {missing} is missing. "
                             "Run ./bookflow check for the full report.") from None

    output = {
        "schema_version": 2,
        "generated_at": date.today().isoformat(),
        "config": config,
        "rating_config": rating_config,
        "catalog": catalog,
        "books": books,
    }
    save(dist / "data/library.json", output)
    removed = prune_audio(dist, built_audio)
    print(f"Built dist/ with {len(books)} book(s) and {len(built_audio)} audio file(s); "
          "deploy the dist directory to any static host")
    if written or removed:
        print(f"  audio: {written} written, {removed} removed, "
              f"{len(built_audio) - written} already current")


def run_managed(command: list[str]) -> None:
    """Run a uv-managed tool and exit with its status.

    uv provides the dependencies these commands need, so a missing uv is a
    setup problem with a one-line fix — not a traceback out of subprocess.
    """
    try:
        completed = subprocess.run(command, cwd=ROOT)
    except FileNotFoundError:
        raise SystemExit(
            "uv is not installed, and it provides this command's dependencies. "
            "Install it from https://docs.astral.sh/uv/ and try again."
        ) from None
    raise SystemExit(completed.returncode)


def check(args: argparse.Namespace) -> None:
    command = ["uv", "run", "scripts/check.py"]
    if args.quiet:
        command.append("--quiet")
    if args.book_id:
        command.append(args.book_id)
    run_managed(command)


def run_tests(_: argparse.Namespace) -> None:
    # Through uv so the suite can import scripts/check.py, which needs
    # jsonschema; the version tracks the one check.py declares for itself.
    run_managed(["uv", "run", "--with", "jsonschema>=4.21",
                 "python", "-m", "unittest", "discover", "-s", "tests"])


def generate_audio(args: argparse.Namespace) -> None:
    command = ["uv", "run", "scripts/generate_audio.py"]
    if args.book_id:
        command.append(args.book_id)
    if args.level:
        command.append(args.level)
    if args.all:
        command.append("--all")
    if args.voice:
        command.extend(["--voice", args.voice])
    if args.speed is not None:
        command.extend(["--speed", str(args.speed)])
    for flag in ("force", "allow_draft", "no_calibrate", "quantized"):
        if getattr(args, flag):
            command.append("--" + flag.replace("_", "-"))
    run_managed(command)


def inspect_pronunciation(args: argparse.Namespace) -> None:
    command = [
        "uv", "run", "scripts/generate_audio.py",
        "--inspect-pronunciation", args.text,
    ]
    if args.voice:
        command.extend(["--voice", args.voice])
    if args.quantized:
        command.append("--quantized")
    run_managed(command)


# Room for far more playlists than a person will make, and small enough that a
# runaway or hostile PUT cannot fill memory.
MAX_PLAYLIST_BYTES = 2_000_000
# The browser sends playlists, not repository conventions. The server owns the
# file's shape, so it restores the schema pointer every other data file carries.
PLAYLISTS_SCHEMA = "../schemas/playlists.schema.json"


class LibraryHandler(SimpleHTTPRequestHandler):
    """Static server plus playlist persistence, audio seeking, and fresh data."""

    def do_GET(self) -> None:  # noqa: N802 (http.server naming)
        path = self.path.split("?", 1)[0]
        if path == "/api/playlists":
            playlists_path = ROOT / "data/playlists.json"
            if playlists_path.exists():
                body = playlists_path.read_bytes()
            else:
                body = json.dumps({"schema_version": 1, "playlists": []}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return
        if self.headers.get("Range"):
            file = self.range_file()
            if file is not None and self.send_ranged(file):
                return
        # serve rebuilds dist on every start, so never let the browser hold a
        # stale copy of anything the build just rewrote. Audio is content-
        # addressed by name and stays cacheable.
        if path.endswith("/data/library.json") or Path(path).name in APP_ASSETS or path == "/":
            self.no_cache = True
        super().do_GET()

    def end_headers(self) -> None:
        if getattr(self, "no_cache", False):
            self.send_header("Cache-Control", "no-store")
            self.no_cache = False
        super().end_headers()

    def discard(self, length: int) -> None:
        """Read and drop a body we will not use, so the client can read the reply.

        Answering before the sender has finished sending breaks the pipe, and
        it never learns why it was refused. Beyond the cap the connection is
        not worth rescuing.
        """
        remaining = min(max(length, 0), 32 * 1024 * 1024)
        while remaining > 0:
            block = self.rfile.read(min(65536, remaining))
            if not block:
                return
            remaining -= len(block)

    def do_PUT(self) -> None:  # noqa: N802
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            length = -1
        if self.path.split("?", 1)[0] != "/api/playlists":
            self.discard(length)
            self.send_error(404)
            return
        if length > MAX_PLAYLIST_BYTES:
            self.discard(length)
            self.send_error(413, "playlists payload too large")
            return
        if length <= 0:
            self.send_error(400, "missing playlists payload")
            return
        try:
            payload = json.loads(self.rfile.read(length))
            if payload.get("schema_version") != 1 or not isinstance(payload.get("playlists"), list):
                raise ValueError("bad shape")
            for playlist in payload["playlists"]:
                if not isinstance(playlist.get("id"), str) or not isinstance(playlist.get("name"), str):
                    raise ValueError("bad playlist")
                for item in playlist.get("items", []):
                    if not isinstance(item.get("book_id"), str) or not isinstance(item.get("duration"), str):
                        raise ValueError("bad item")
        except (json.JSONDecodeError, ValueError, AttributeError):
            self.send_error(400, "invalid playlists payload")
            return
        target = ROOT / "data/playlists.json"
        scratch = target.with_suffix(".json.tmp")
        document = {"$schema": PLAYLISTS_SCHEMA, **payload}
        scratch.write_text(json.dumps(document, indent=2, ensure_ascii=False) + "\n",
                           encoding="utf-8")
        scratch.replace(target)
        body = b'{"ok": true}'
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def range_file(self) -> Path | None:
        candidate = Path(self.translate_path(self.path.split("?", 1)[0]))
        return candidate if candidate.is_file() else None

    def send_ranged(self, file: Path) -> bool:
        """Answer a single-range request.

        False when the header is not a single byte range this server can
        honour — a multi-range or malformed header — so the caller serves the
        whole file, which RFC 9110 permits and browsers expect.
        """
        size = file.stat().st_size
        match = re.match(r"bytes=(\d*)-(\d*)$", self.headers["Range"].strip())
        if not match or not (match.group(1) or match.group(2)):
            return False
        start, end = 0, size - 1
        if match.group(1):
            start = int(match.group(1))
            if match.group(2):
                end = min(int(match.group(2)), size - 1)
        else:
            start = max(0, size - int(match.group(2)))
        if start >= size or start > end:
            self.send_response(416)
            self.send_header("Content-Range", f"bytes */{size}")
            self.end_headers()
            return True
        self.send_response(206)
        self.send_header("Content-Type", self.guess_type(str(file)))
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.send_header("Content-Length", str(end - start + 1))
        self.end_headers()
        with file.open("rb") as handle:
            handle.seek(start)
            remaining = end - start + 1
            while remaining > 0:
                block = handle.read(min(65536, remaining))
                if not block:
                    break
                try:
                    self.wfile.write(block)
                except (BrokenPipeError, ConnectionResetError):
                    return True  # the listener seeked away or closed the tab
                remaining -= len(block)
        return True

    def log_message(self, format: str, *args: object) -> None:
        if len(args) > 1 and str(args[1]).startswith(("2", "3")):
            return  # successful requests are noise
        super().log_message(format, *args)


def serve(args: argparse.Namespace) -> None:
    build_app()
    url = f"http://127.0.0.1:{args.port}/"
    handler = partial(LibraryHandler, directory=str(ROOT / "dist"))
    try:
        server = ThreadingHTTPServer(("127.0.0.1", args.port), handler)
    except OSError as error:
        raise SystemExit(f"Cannot serve on port {args.port} ({error.strerror or error}); "
                         "another server may be running — try --port")
    print(f"Library: {url}")
    if not args.no_open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nLibrary server stopped.")
    finally:
        server.server_close()


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    commands = root.add_subparsers(dest="command", required=True)
    create = commands.add_parser("init", help="create a researched-book workspace")
    create.add_argument("--title", required=True)
    create.add_argument("--author", required=True)
    create.add_argument("--book-id")
    create.add_argument("--author-id")
    create.add_argument("--force", action="store_true",
                        help="create even when the catalog has a similar-looking title")
    create.add_argument("--note", help="note stored on the queue entry (edition caveats, co-authors)")
    create.add_argument("--discovered", action="store_true",
                        help="queue this book as agent-discovered rather than owner-requested")
    create.set_defaults(run=init_book)

    work = commands.add_parser("queue", help="show the processing queue and what each book needs")
    work.add_argument("--set", nargs=2, metavar=("BOOK_ID", "STATUS"),
                      help="set a queue entry to " + ", ".join(QUEUE_STATUSES))
    work.set_defaults(run=cmd_queue)

    upcoming = commands.add_parser("next", help="show the next ready book and its research prompt")
    upcoming.add_argument("--claim", action="store_true", help="mark it in-progress")
    upcoming.set_defaults(run=cmd_next)

    rate = commands.add_parser("rate", help="calculate a reputation-blind score from rubric dimensions")
    rate.add_argument("book_id")
    rate.add_argument("--write", action="store_true", help="write the calculated total to content.json")
    rate.set_defaults(run=cmd_rate)

    validate = commands.add_parser("check", help="validate schemas, references, and word counts")
    validate.add_argument("book_id", nargs="?")
    validate.add_argument("--quiet", action="store_true", help="show only warnings and errors")
    validate.set_defaults(run=check)

    verify = commands.add_parser("test", help="run the unit tests for the shared tooling")
    verify.set_defaults(run=run_tests)

    build = commands.add_parser("build", help="build the static app data")
    build.set_defaults(run=build_app)

    local = commands.add_parser("serve", help="build and serve the local library UI")
    local.add_argument("--port", type=int, default=8042)
    local.add_argument("--no-open", action="store_true")
    local.set_defaults(run=serve)

    audio = commands.add_parser("audio", help="generate local Kokoro audio (a book, a level, or --all)")
    audio.add_argument("book_id", nargs="?")
    audio.add_argument("level", nargs="?")
    audio.add_argument("--all", action="store_true", help="every book, every level")
    audio.add_argument("--voice")
    audio.add_argument("--speed", type=float)
    audio.add_argument("--force", action="store_true", help="regenerate even when up to date")
    audio.add_argument("--allow-draft", action="store_true", help="voice scripts not marked complete")
    audio.add_argument("--no-calibrate", action="store_true", help="skip words-per-minute calibration")
    audio.add_argument("--quantized", action="store_true", help="use the smaller int8 model")
    audio.set_defaults(run=generate_audio)

    pronunciation = commands.add_parser(
        "pronunciation",
        help="inspect Kokoro phonemes and shared-dictionary matches",
    )
    pronunciation.add_argument("text", help="a name, title, term, or short phrase")
    pronunciation.add_argument("--voice")
    pronunciation.add_argument("--quantized", action="store_true", help="use the smaller int8 model")
    pronunciation.set_defaults(run=inspect_pronunciation)
    return root


if __name__ == "__main__":
    arguments = parser().parse_args()
    arguments.run(arguments)

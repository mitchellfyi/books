# Narration audio is committed, so the published site can carry it: GitHub
# Pages builds from this repository and cannot generate 616 MB of speech.
# That is a distribution decision, not a change of mind about what audio is —
# it is still derived output, still reproducible from the scripts, and every
# regeneration adds its full weight to history permanently. Moving it to
# object storage would let this go back to being ignored.
#
# Not Git LFS: Pages does not resolve LFS pointers without extra checkout
# configuration, and the free 1 GB monthly LFS bandwidth would be spent after
# two CI runs.

# Build output: a complete static site, regenerated by ./bookflow build.
dist/

# Python bytecode
__pycache__/
.DS_Store
.playwright-mcp/

# Locally downloaded text-to-speech model assets.
models/

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/tags.schema.json",
  "title": "Canonical tags",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tags"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "description", "aliases"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["genre", "topic", "audience", "period", "region", "format"] },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}

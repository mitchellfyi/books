{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/rating-config.schema.json",
  "title": "Content-only book rating rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scale", "dimensions", "anchors", "score_bands", "confidence", "excluded_factors"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "dimension_increment", "output_decimals"],
      "properties": {
        "minimum": { "const": 0 },
        "maximum": { "const": 10 },
        "dimension_increment": { "const": 0.5 },
        "output_decimals": { "const": 1 }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "weight", "question"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "question": { "type": "string", "minLength": 1 }
        }
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["score", "description"],
        "properties": {
          "score": { "type": "number", "minimum": 0, "maximum": 10 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "score_bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimum", "maximum", "label"],
        "properties": {
          "minimum": { "type": "number", "minimum": 0, "maximum": 10 },
          "maximum": { "type": "number", "minimum": 0, "maximum": 10 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "medium", "high"],
      "properties": {
        "low": { "type": "string", "minLength": 1 },
        "medium": { "type": "string", "minLength": 1 },
        "high": { "type": "string", "minLength": 1 }
      }
    },
    "excluded_factors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}

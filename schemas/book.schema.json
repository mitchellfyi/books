{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/book.schema.json",
  "title": "Book profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "title", "alternate_titles", "author_ids", "bibliography", "discovery", "research", "workflow"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "type": { "const": "book" },
    "title": { "type": "string", "minLength": 1 },
    "alternate_titles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "author_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "bibliography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_published", "original_language", "editions", "contents"],
      "properties": {
        "first_published": { "type": ["string", "null"] },
        "original_language": { "type": ["string", "null"] },
        "editions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "publisher", "publication_date", "isbn_10", "isbn_13", "format", "pages"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "publisher": { "type": ["string", "null"] },
              "publication_date": { "type": ["string", "null"] },
              "isbn_10": { "type": ["string", "null"] },
              "isbn_13": { "type": ["string", "null"] },
              "format": { "type": ["string", "null"] },
              "pages": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        },
        "contents": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_ids", "audiences", "formats_available"],
      "properties": {
        "tag_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "audiences": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "formats_available": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "research": { "$ref": "#/$defs/research" },
    "workflow": { "$ref": "#/$defs/workflow" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "basis": { "enum": ["explicit", "synthesis", "inference"] },
    "source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "author_or_publisher", "url", "type", "independence", "quality", "accessed_at", "supports", "limitations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "author_or_publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "type": { "enum": ["book", "publisher", "library-catalogue", "author", "employer", "interview", "professional-review", "specialist-review", "reader-aggregate", "secondary-summary", "official-documentation"] },
        "independence": { "enum": ["primary", "independent", "interested", "community"] },
        "quality": { "enum": ["high", "medium", "limited"] },
        "accessed_at": { "type": "string", "format": "date" },
        "supports": { "type": "string", "minLength": 1 },
        "limitations": { "type": "string", "minLength": 1 }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "citations"],
      "properties": {
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "citations": {
          "type": "object",
          "propertyNames": { "pattern": "^/" },
          "additionalProperties": { "$ref": "#/$defs/source_ids" }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "coverage", "coverage_notes", "last_researched", "next_steps"],
      "properties": {
        "status": { "enum": ["stub", "researched-partial", "complete"] },
        "coverage": { "enum": ["metadata-only", "sample-and-secondary", "full-book"] },
        "coverage_notes": { "type": "string" },
        "last_researched": { "type": "string", "format": "date" },
        "next_steps": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

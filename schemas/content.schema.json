{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/content.schema.json",
  "title": "Structured non-fiction book content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "book_id", "content_type", "editorial", "card", "overview", "ideas", "book_map", "reading_experience", "assessment", "retention", "workflow"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "book_id": { "$ref": "#/$defs/id" },
    "content_type": { "const": "non-fiction" },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compression_fit", "complexity", "recommended_level", "rationale"],
      "properties": {
        "compression_fit": { "enum": ["high", "medium", "low"] },
        "complexity": { "enum": ["low", "medium", "high"] },
        "recommended_level": { "enum": ["5-minutes", "15-minutes", "30-minutes"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_sentence", "verdict", "source_ids", "basis"],
      "properties": {
        "one_sentence": { "type": "string", "minLength": 1 },
        "verdict": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/source_ids" },
        "basis": { "$ref": "#/$defs/basis" }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synopsis", "core_argument"],
      "properties": {
        "synopsis": { "$ref": "#/$defs/claim" },
        "core_argument": { "$ref": "#/$defs/claim" }
      }
    },
    "ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "claim", "explanation", "representative_example", "why_it_matters", "caveat", "source_ids", "basis"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "representative_example": { "type": ["string", "null"] },
          "why_it_matters": { "type": "string", "minLength": 1 },
          "caveat": { "type": ["string", "null"] },
          "source_ids": { "$ref": "#/$defs/source_ids" },
          "basis": { "$ref": "#/$defs/basis" }
        }
      }
    },
    "book_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "title", "purpose", "summary", "idea_ids", "source_ids", "basis"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "idea_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "source_ids": { "$ref": "#/$defs/source_ids" },
          "basis": { "$ref": "#/$defs/basis" }
        }
      }
    },
    "reading_experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "voice", "pace", "evidence_style", "example_style", "repetition", "prerequisites", "source_ids", "basis"],
      "properties": {
        "structure": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 },
        "pace": { "type": "string", "minLength": 1 },
        "evidence_style": { "type": "string", "minLength": 1 },
        "example_style": { "type": "string", "minLength": 1 },
        "repetition": { "type": "string", "minLength": 1 },
        "prerequisites": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/source_ids" },
        "basis": { "$ref": "#/$defs/basis" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning", "lessons", "importance", "author_and_purpose", "evidence_quality", "reception", "audience", "scope", "decision"],
      "properties": {
        "rating": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rubric_version", "score", "confidence", "summary", "dimensions", "basis"],
          "properties": {
            "rubric_version": { "const": 1 },
            "score": { "type": "number", "minimum": 0, "maximum": 10, "multipleOf": 0.1 },
            "confidence": { "enum": ["low", "medium", "high"] },
            "summary": { "type": "string", "minLength": 1 },
            "dimensions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "score", "rationale", "source_ids"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "score": { "type": "number", "minimum": 0, "maximum": 10, "multipleOf": 0.5 },
                  "rationale": { "type": "string", "minLength": 1 },
                  "source_ids": { "$ref": "#/$defs/source_ids" }
                }
              }
            },
            "basis": { "const": "inference" }
          }
        },
        "meaning": { "$ref": "#/$defs/claim" },
        "lessons": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "importance": { "$ref": "#/$defs/claim" },
        "author_and_purpose": { "$ref": "#/$defs/claim" },
        "evidence_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rating", "strengths", "weaknesses", "source_ids", "basis"],
          "properties": {
            "rating": { "enum": ["strong", "mixed", "weak", "not-assessed"] },
            "strengths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "weaknesses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "source_ids": { "$ref": "#/$defs/source_ids" },
            "basis": { "$ref": "#/$defs/basis" }
          }
        },
        "reception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "praise", "criticism", "source_ids", "basis"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "praise": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "criticism": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "source_ids": { "$ref": "#/$defs/source_ids" },
            "basis": { "$ref": "#/$defs/basis" }
          }
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["best_for", "not_for", "topics", "source_ids", "basis"],
          "properties": {
            "best_for": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "not_for": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "topics": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "source_ids": { "$ref": "#/$defs/source_ids" },
            "basis": { "$ref": "#/$defs/basis" }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["is_not", "omissions", "missing_or_weak", "dated_or_contested", "source_ids", "basis"],
          "properties": {
            "is_not": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "omissions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "missing_or_weak": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "dated_or_contested": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "source_ids": { "$ref": "#/$defs/source_ids" },
            "basis": { "$ref": "#/$defs/basis" }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read_if", "summary_is_enough_if", "skip_if", "format_advice", "source_ids", "basis"],
          "properties": {
            "read_if": { "type": "string", "minLength": 1 },
            "summary_is_enough_if": { "type": "string", "minLength": 1 },
            "skip_if": { "type": "string", "minLength": 1 },
            "format_advice": { "type": "string", "minLength": 1 },
            "source_ids": { "$ref": "#/$defs/source_ids" },
            "basis": { "$ref": "#/$defs/basis" }
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recall_prompts", "application_prompts"],
      "properties": {
        "recall_prompts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "application_prompts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_against_full_book", "review_notes"],
      "properties": {
        "status": { "enum": ["stub", "researched-partial", "complete"] },
        "reviewed_against_full_book": { "type": "boolean" },
        "review_notes": { "type": "string" },
        "quality_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewed_at", "checks", "notes"],
          "allOf": [
            {
              "if": {
                "properties": { "status": { "const": "passed" } },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "reviewed_at": { "type": "string", "format": "date" },
                  "checks": {
                    "properties": {
                      "identity_and_metadata": { "const": true },
                      "content_fidelity": { "const": true },
                      "claim_support": { "const": true },
                      "counterevidence": { "const": true },
                      "citation_entailment": { "const": true },
                      "product_fit": { "const": true },
                      "plain_language": { "const": true },
                      "audio_pronunciation": { "const": true }
                    }
                  }
                }
              }
            }
          ],
          "properties": {
            "status": { "enum": ["pending", "passed", "blocked"] },
            "reviewed_at": { "type": ["string", "null"], "format": "date" },
            "checks": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identity_and_metadata", "content_fidelity", "claim_support", "counterevidence", "citation_entailment", "product_fit", "plain_language", "audio_pronunciation"],
              "properties": {
                "identity_and_metadata": { "type": "boolean" },
                "content_fidelity": { "type": "boolean" },
                "claim_support": { "type": "boolean" },
                "counterevidence": { "type": "boolean" },
                "citation_entailment": { "type": "boolean" },
                "product_fit": { "type": "boolean" },
                "plain_language": { "type": "boolean" },
                "audio_pronunciation": { "type": "boolean" }
              }
            },
            "notes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "basis": { "enum": ["explicit", "synthesis", "inference"] },
    "source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_ids", "basis"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source_ids": { "$ref": "#/$defs/source_ids" },
        "basis": { "$ref": "#/$defs/basis" }
      }
    }
  }
}
